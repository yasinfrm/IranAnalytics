# --- Node app (npm start) — these names are what the process reads ---
# Stock app does NOT auto-load this file; export them or use systemd Environment=.

# SQLite (no system Postgres — recommended on AlmaLinux when dnf is blocked):
DATABASE_URL=sqlite:./data/iran-analytics.db
# Postgres alternative:
# DATABASE_URL=postgres://iran_analytics:change-this-strong-password@127.0.0.1:5432/iran_analytics

PORT=3000
ADMIN_USERNAME=admin
# Prefer a bcrypt hash: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Or plain password for first boot:
ADMIN_PASSWORD=changeme
COOKIE_SECURE=false
TRUST_PROXY=true
NODE_ENV=production
# Optional: force pure-JS SQLite (skip better-sqlite3 native build)
# IA_FORCE_SQLJS=1

# --- Docker Compose only (ignored by npm start) ---
APP_PORT=3000
POSTGRES_USER=iran_analytics
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=iran_analytics
