{
  "name": "iran-analytics",
  "version": "1.0.0",
  "description": "Lightweight self-hosted web analytics for Iran — Persian admin, no blocked CDNs",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
